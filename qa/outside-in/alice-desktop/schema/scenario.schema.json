              "xvfb-real-alice",
              "gated-command-smoke"
            ]
          }
        },
        "required": [
          "automationMode"
        ]
      },
      "then": {
        "required": [
          "automation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "workflow": {
            "enum": [
              "project-io-smoke",
              "save-menu-dialog-write-proof"
            ]
          }
        },
        "required": [
          "workflow"
        ]
      },
      "then": {
        "properties": {
          "automation": {
            "not": {
              "required": [
                "timeoutSeconds"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "automation": {
            "required": [
              "timeoutSeconds"
            ]
          }
        }
      }
    }
