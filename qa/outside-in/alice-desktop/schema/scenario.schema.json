{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rysweet/alice3-modernization/qa/outside-in/alice-desktop/schema/scenario.schema.json",
  "title": "Alice desktop outside-in scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "workflow",
    "automationMode",
    "preconditions",
    "userActions",
    "expectedOutcomes",
    "evidence",
    "fallback"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^alice-desktop-[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "agents": {
      "type": "array",
      "items": { "type": "string" }
    },
    "workflow": {
      "type": "string",
      "enum": [
        "archive-fixture-smoke",
        "export",
        "exported-project-ant-build-smoke",
        "failure-path-smoke",
        "file-loader-smoke",
        "first-lesson-live-procedure-target-observation",
        "future-ui-smoke",
        "instructor-student-setup",
        "launch",
        "menu-action-smoke",
        "netbeans-package-smoke",
        "open-load-save",
        "package-install-smoke",
        "project-io-smoke",
        "run-debug",
        "save-load",
        "save-menu-dialog-write-proof",
        "scene-creation",
        "select-project-interaction-smoke",
        "select-project-widget-introspection-smoke",
        "select-project-atk-exec-smoke",
        "select-project-tab-click-smoke",
        "post-project-open-window-state-smoke",
        "post-open-runtime-display-accessibility-evidence",
        "procedure-edit-handoff-smoke",
        "procedure-edit-seam-smoke",
        "silver-thread-launch-build-run",
        "tweedle-decoder-boundary-smoke",
        "tweedle-decoder-this-call-smoke",
        "wizard-palette-completion-smoke"
      ]
    },
    "automationMode": {
      "type": "string",
      "enum": [
        "gated-command-smoke",
        "xvfb-real-alice",
        "manual-evidence-required"
      ]
    },
    "preconditions": {
      "$ref": "#/$defs/nonEmptyStringList"
    },
    "userActions": {
