<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.alice</groupId>
    <artifactId>parent</artifactId>
    <version>9.1.0-SNAPSHOT</version>
  </parent>

  <name>Alice Coverage Aggregate</name>
  <artifactId>coverage-report</artifactId>
  <packaging>pom</packaging>

  <dependencies>
    <dependency>
      <groupId>org.alice</groupId>
      <artifactId>ast</artifactId>
    </dependency>
    <dependency>
      <groupId>org.alice</groupId>
      <artifactId>croquet</artifactId>
    </dependency>
    <dependency>
      <groupId>org.alice</groupId>
      <artifactId>i18n</artifactId>
    </dependency>
    <dependency>
      <groupId>org.alice</groupId>
      <artifactId>ide</artifactId>
    </dependency>
    <dependency>
      <groupId>org.alice</groupId>
      <artifactId>image-editor</artifactId>
    </dependency>
    <dependency>
      <groupId>org.alice</groupId>
      <artifactId>issue-reporting</artifactId>
    </dependency>
    <dependency>
      <groupId>org.alice</groupId>
      <artifactId>resources</artifactId>
    </dependency>
    <dependency>
      <groupId>org.alice</groupId>
      <artifactId>scenegraph</artifactId>
    </dependency>
    <dependency>
      <groupId>org.alice</groupId>
      <artifactId>glrender</artifactId>
    </dependency>
    <dependency>
      <groupId>org.alice</groupId>
      <artifactId>story-api-migration</artifactId>
    </dependency>
    <dependency>
      <groupId>org.alice</groupId>
      <artifactId>story-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.alice</groupId>
      <artifactId>util</artifactId>
    </dependency>
    <dependency>
      <groupId>org.alice</groupId>
      <artifactId>model-loading</artifactId>
    </dependency>
    <dependency>
      <groupId>org.alice</groupId>
      <artifactId>tweedle</artifactId>
    </dependency>
    <dependency>
      <groupId>org.alice</groupId>
      <artifactId>models</artifactId>
    </dependency>
    <dependency>
      <groupId>org.alice</groupId>
      <artifactId>alice-ide</artifactId>
    </dependency>
    <dependency>
      <groupId>org.alice</groupId>
      <artifactId>netbeans</artifactId>
      <version>${project.version}</version>
      <type>nbm</type>
    </dependency>
    <dependency>
      <groupId>com.dddviewr</groupId>
      <artifactId>collada</artifactId>
    </dependency>
    <dependency>
      <groupId>org.alice.external</groupId>
      <artifactId>collada-schema-1-4-1</artifactId>
    </dependency>
    <dependency>
      <groupId>org.alice.external</groupId>
      <artifactId>wrapped-flow-layout</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>aggregate-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
            <configuration>
              <title>Alice open-asset aggregate coverage</title>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
